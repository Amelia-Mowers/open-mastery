{
  "name": "cairn",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "server": "node src/server/main.ts",
    "dev": "vite",
    "build": "vite build",
    "build:demo": "node scripts/build-demo-bundle.mjs && vite build --mode demo && node -e \"const fs=require('fs');fs.renameSync('dist-demo/demo.html','dist-demo/index.html')\"",
    "voice:check": "node --experimental-transform-types scripts/check-voice-coverage.ts"
  },
  "dependencies": {
    "@openmastery/schema": "file:../schema",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@huggingface/hub": "^2.16.1",
    "kokoro-js": "^1.2.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "fast-check": "^4.9.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
